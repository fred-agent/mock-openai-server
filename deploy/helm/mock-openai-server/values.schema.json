{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["benchmark"],
  "properties": {
    "benchmark": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["none", "reference", "streaming"]
        }
      }
    }
  }
}
