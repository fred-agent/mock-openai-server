environments:
  bench: {}
---
{{- $checkout := requiredEnv "DIR" }}
helmDefaults:
  kubeContext: k3d-fred
  createNamespace: true
  wait: true
  timeout: 300
  historyMax: 10

releases:
  - name: mock-openai-server
    namespace: fred-{{ .Environment.Name }}
    chart: {{ printf "%s/deploy/helm/mock-openai-server" $checkout | quote }}
    values:
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
